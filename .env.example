# ============================================================================
# MCPFactory Environment Configuration
# ============================================================================

# Path to the declarative MCP JSON/YAML blueprint
MCP_CONFIG_PATH=configs/ecommerce_service.json

# Server transport mode: "http" (Cloud Run / SSE + Streamable HTTP) or "stdio" (Local Desktop)
MCP_TRANSPORT=http

# Port injected automatically by Google Cloud Run (defaults to 8080)
PORT=8080
HOST=0.0.0.0

# Optional: Inbound API Key / Bearer Token to protect your Cloud Run MCP Server
# If set, clients must pass `Authorization: Bearer <MCP_SERVER_API_KEY>` or `X-MCP-API-Key: <MCP_SERVER_API_KEY>`
MCP_SERVER_API_KEY=

# ============================================================================
# Outbound Backend Service Credentials (Referenced in your JSON config via ${VAR})
# ============================================================================
ORDER_SERVICE_BASE_URL=https://jsonplaceholder.typicode.com
ORDER_SERVICE_API_KEY=demo-secret-api-key-12345

GRAPHQL_COUNTRIES_URL=https://countries.trevorblades.com/graphql

GITHUB_API_TOKEN=ghp_example_token_replace_me
CRM_CLIENT_ID=your_oauth_client_id
CRM_CLIENT_SECRET=your_oauth_client_secret
CRM_TOKEN_URL=https://auth.example.com/oauth/token
